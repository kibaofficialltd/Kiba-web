{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node -e \"console.log('Black Shores portal ready')\"",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/((?!router).*)", "destination": "/api/router?path=$1" }
  ]
}

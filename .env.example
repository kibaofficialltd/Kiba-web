# ---------------------------------------------------------------------------
# KIBAOFFICIAL SMP — environment template
# Copy to `.env` (never commit `.env`).
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Postgres / Supabase connection string. For Supabase use the pooled
# "Transaction" connection string and set DATABASE_SSL=true.
DATABASE_URL=postgresql://kiba:kiba@127.0.0.1:5432/kibaofficial
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Public site origin, no trailing slash. Used for verification links + cookies.
APP_URL=http://localhost:3000
NODE_ENV=development

# --- Minecraft server (displayed on the site) -------------------------------
# These are PUBLIC values rendered in the hero and the copy-IP button.
NEXT_PUBLIC_SERVER_HOST=sg-sgp07.altare.global
NEXT_PUBLIC_SERVER_PORT=25449
NEXT_PUBLIC_SERVER_BEDROCK_PORT=25449
NEXT_PUBLIC_SERVER_VERSION=Java 1.16 - 26.x · Bedrock 1.21.x

# --- KIBAOFFICIALCore plugin bridge ----------------------------------------
# Shared secret used to HMAC-sign every plugin <-> website request.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PLUGIN_SHARED_SECRET=change-me-to-a-64-char-random-hex-string
# How long a plugin-signed request stays valid (seconds).
PLUGIN_TIMESTAMP_TOLERANCE=300

# --- Brand / social ---------------------------------------------------------
# Logo slot: drop your file at /public/brand/logo.(svg|png|webp) and it is
# picked up automatically. Set NEXT_PUBLIC_LOGO to override the filename.
NEXT_PUBLIC_BRAND_NAME=KIBAOFFICIAL
NEXT_PUBLIC_BRAND_SUFFIX=SMP
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/UFFn3hmBCF
NEXT_PUBLIC_WHATSAPP_URL=https://chat.whatsapp.com/CL77NhYJRAj0if3WsgViDP?s=cl&p=a&mlu=4&ilr=4&iam=2
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/kiba_official_ig?rpxt=bjA4NnRvZGE4OXZ4
NEXT_PUBLIC_YOUTUBE_URL=https://youtube.com/@kiba_official_yt?si=q694OfjU-Ik3OGPT
NEXT_PUBLIC_STORE_ENABLED=true

# --- Email (optional) -------------------------------------------------------
# Without SMTP the app writes verification/reset links to the `emergency_outbox`
# table and logs them; this is intended for local development only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KIBAOFFICIAL SMP <no-reply@kibaofficial.fun>"

# --- Ops --------------------------------------------------------------------
# Comma-separated IPs allowed to call /api/plugin/* (empty = any, HMAC still required)
PLUGIN_IP_ALLOWLIST=
# Bearer token for POST /api/cron/prune (housekeeping). Leave empty to disable.
CRON_SECRET=
